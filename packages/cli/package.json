{
  "name": "nextship-cli",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "author": "Gowtham <gowtham9112006@gmail.com>",
  "contributors": [
    "Ragul D <raguld2105@gmail.com>"
  ],
  "description": "Deploy any Next.js app to your own cloud account or your own server, with no configuration.",
  "keywords": [
    "nextjs",
    "next",
    "deploy",
    "deployment",
    "digitalocean",
    "docker",
    "adapter",
    "self-hosted",
    "ssh",
    "vps",
    "caddy"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "nextship": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "runtime",
    "!runtime/*.log",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-adapter.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/**/*.test.js\"",
    "prepack": "node scripts/copy-legal.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gowtham472/nextship.git"
  },
  "homepage": "https://nextship.doodlebytestudio.in",
  "bugs": {
    "url": "https://github.com/gowtham472/nextship/issues"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@nextship/adapter": "workspace:*",
    "@types/cross-spawn": "^6.0.6"
  }
}
