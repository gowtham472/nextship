[6.358811, "o", "\u001b[34m>\u001b[0m Plan for 206.189.129.78\r\n  \u001b[90mserver        root@206.189.129.78:22\u001b[0m\r\n"]
[6.359936, "o", "  \u001b[90mhost key      ssh-ed25519 SHA256:AeV943uXkIeHXZwh4WV4PgV+MTNFXXyH/E+hE4RvBfU, trusted from now on if you continue\u001b[0m\r\n"]
[6.360353, "o", "  \u001b[90mos            ok     ubuntu 24.04\u001b[0m\r\n  \u001b[90march          ok     amd64\u001b[0m\r\n"]
[6.360617, "o", "  \u001b[90mresources     ok     1967 MiB RAM, 0 MiB swap, 45 GB free\u001b[0m\r\n  \u001b[90mports         ok     80 and 443 are free for Caddy\u001b[0m\r\n  \u001b[90mdocker        CHANGE install Docker CE from Docker's apt repository\u001b[0m\r\n"]
[6.360752, "o", "  \u001b[90muser          CHANGE create the nextship user in the docker and systemd-journal groups\u001b[0m\r\n  \u001b[90mdirs          CHANGE create /etc/nextship, owned by nextship, mode 0700\u001b[0m\r\n"]
[6.360896, "o", "  \u001b[90mnetwork       CHANGE create the nextship Docker network, once Docker runs\u001b[0m\r\n  \u001b[90mcaddy         CHANGE run Caddy (caddy:2.10) on ports 80 and 443, once Docker runs\u001b[0m\r\n  \u001b[90mjournald      CHANGE limit the journal to 500M, since app logs are kept there\u001b[0m\r\n"]
[6.361103, "o", "  \u001b[90mswap          CHANGE add a 2 GB swap file, since 1967 MiB RAM is tight for a build\u001b[0m\r\n  \u001b[90mupdates       ok     security updates install automatically\u001b[0m\r\n"]
[6.361286, "o", "  \u001b[90mfirewall      CHANGE enable ufw allowing SSH (22), 80 and 443\u001b[0m\r\n  \u001b[90mwatchdog      CHANGE install a watchdog that restarts containers unhealthy for 3 checks in a row\u001b[0m\r\n  \u001b[90mssh-hardening CHANGE turn off password logins and allow root by key only\u001b[0m\r\n  \u001b[90mafterwards    nextship connects as nextship@206.189.129.78:22\u001b[0m\r\n  \u001b[90muntouched     other containers, the Docker daemon configuration, and DNS\u001b[0m\r\n"]
[6.361625, "o", "\u001b[33m!\u001b[0m Membership of the docker group is root-equivalent: whoever can log in as nextship controls this server.\r\n\u001b[33m!\u001b[0m Compare SHA256:AeV943uXkIeHXZwh4WV4PgV+MTNFXXyH/E+hE4RvBfU with the host key your provider shows for this server before you continue.\r\n"]
[6.361937, "o", "\u001b[32mv\u001b[0m This was a plan only. Nothing was changed.\r\n  \u001b[90mRun the same command with --yes to set it up and record it in nextship.json.\u001b[0m\r\n"]
