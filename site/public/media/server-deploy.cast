[74.726125, "o", "  \u001b[90mtarget        your server 206.189.129.78, amd64, Docker 29.8.1\u001b[0m\r\n  \u001b[90mbuild         on the server's Docker 29.8.1, for linux/amd64, over SSH\u001b[0m\r\n"]
[74.72923, "o", "  \u001b[90mimage         kept on the server as acme-web:<deployment id>\u001b[0m\r\n"]
[74.730239, "o", "  \u001b[90mapp           CREATE \"acme-web\" in /etc/nextship/apps/acme-web\u001b[0m\r\n"]
[74.732474, "o", "  \u001b[90mmemory        up to 1573m of 1967 MiB\u001b[0m\r\n  \u001b[90maddress       http://206.189.129.78\u001b[0m\r\n  \u001b[90mswitch        Caddy moves traffic only once the new container is healthy; until then the current one serves\u001b[0m\r\n"]
[74.734405, "o", "  \u001b[90mcaddy         the site is regenerated from the domains recorded for this app\u001b[0m\r\n  \u001b[90muntouched     0 existing app(s) on this server\u001b[0m\r\n  \u001b[90mremoves images older than the newest 5 served deployments once this one is live; nothing else is deleted\u001b[0m\r\n"]
[74.920578, "o", "  \u001b[90mServer Actions key generated and stored on the server, not on this machine\u001b[0m\r\n"]
